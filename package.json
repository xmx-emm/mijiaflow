{
  "name": "mijiaflow",
  "version": "0.2.0",
  "description": "Unofficial local MCP server for auditing and controlling Mijia Central Hub Geek Edition automations.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "xmx-emm",
    "url": "https://github.com/xmx-emm"
  },
  "homepage": "https://github.com/xmx-emm/mijiaflow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmx-emm/mijiaflow.git"
  },
  "bugs": "https://github.com/xmx-emm/mijiaflow/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mijia",
    "xiaomi",
    "smart-home",
    "home-automation",
    "automation"
  ],
  "bin": {
    "mijiaflow": "mcp/dist/server.js"
  },
  "files": [
    "mcp/dist/server.js",
    "README.zh-CN.md",
    "docs/"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run verify",
    "start": "node mcp/dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/curves": "2.3.0",
    "undici": "7.29.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
